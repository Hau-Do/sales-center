{
  "name": "sales-center",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Keyloop Sales Center \u2014 a sales lead management tool for automotive dealerships",
  "engines": {
    "node": "^20.19.0 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:determinism": "node scripts/check-determinism.mjs",
    "mutation-sanity": "node scripts/mutation-sanity.mjs",
    "e2e": "VITE_E2E=1 start-server-and-test 'npm run dev' http://localhost:5173 'cypress run'",
    "e2e:open": "VITE_E2E=1 start-server-and-test 'npm run dev' http://localhost:5173 'cypress open --e2e'",
    "e2e:ci": "VITE_E2E=1 npm run build && VITE_E2E=1 start-server-and-test 'npm run preview' http://localhost:4173 'cypress run --config baseUrl=http://localhost:4173'",
    "verify": "npm run typecheck && npm run lint && npm run verify:determinism && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "web-vitals": "^6.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.0.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.8",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
